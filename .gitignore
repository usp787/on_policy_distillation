# Slurm logs: keep only the compact .out (eval results print there); ignore the noisy .err
# (progress bars/warnings) plus any .log/.jsonl, so the cluster's freshly-generated copies
# never collide with `git pull` (a tracked file the cluster regenerates blocks the merge).
# logs/* (not logs/) lets the negations below re-include the files we DO want to keep.
logs/*
!logs/.gitkeep
!logs/*.out

# Model weights — never commit (blows the 80 GB quota)
*.safetensors
*.bin
*.pt
checkpoints/

# HF cache
hf_cache/
.cache/

# Datasets cached locally (re-downloaded via prepare_data.py on the cluster)
data/*.json
data/*.jsonl
data/*.parquet
data/*.arrow
!data/.gitkeep

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/

# Editor / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Results: commit the deliverables (metrics .json + small .png — see README §12), but ignore
# bulk/regenerated dumps (.jsonl) and any stray .err/.log so they don't block `git pull`.
results/*.jsonl
results/*.err
results/*.log
!results/
!results/*.json
!results/*.png
